# Local overrides (copy to .env.local, which is gitignored).
# Preview another stage without touching Remote Config:
PUBLIC_SITE_STAGE=waitlist
# Website analytics (GA4). Leave empty to build without analytics and the cookie banner.
PUBLIC_FIREBASE_MEASUREMENT_ID=
# Content: a read-only DatoCMS Content Delivery API token. Required to build or run the site.
DATOCMS_API_TOKEN=
