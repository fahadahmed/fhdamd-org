{
  "name": "jamaal-web-functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore --project demo-jamaal-web",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/pubsub": "^4.11.0",
    "@sentry/node": "^10.71.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.2",
    "resend": "^6.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "private": true
}
