---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Why from "../components/sections/Why.astro";
import Order from "../components/sections/Order.astro";
import Everywhere from "../components/sections/Everywhere.astro";
import DayStory from "../components/sections/DayStory.astro";
import NightPlanning from "../components/sections/NightPlanning.astro";
import Principles from "../components/sections/Principles.astro";
import DeveloperNote from "../components/sections/DeveloperNote.astro";
import Pricing from "../components/sections/Pricing.astro";
import PrivacySection from "../components/sections/PrivacySection.astro";
import Faq from "../components/sections/Faq.astro";
import Join from "../components/sections/Join.astro";
import { LAUNCHED } from "../data/site";
import { softwareApplicationJsonLd } from "../data/seo";
import { loadHome } from "../lib/cms/pages";

const { site, page: home } = await loadHome();

const jsonLd = softwareApplicationJsonLd({
  origin: Astro.site!.origin,
  description: site.description,
  launched: LAUNCHED,
  plans: home.pricing.plans,
});
---

<Layout site={site}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <Hero hero={home.hero} form={home.form} appStoreUrl={site.appStoreUrl} />
  <Why why={home.why} />
  <Order order={home.order} />
  <DayStory day={home.day} />
  <NightPlanning plan={home.plan} />
  <Everywhere everywhere={home.everywhere} />
  <Principles principles={home.principles} />
  <DeveloperNote developerNote={home.developerNote} />
  <Pricing pricing={home.pricing} />
  <PrivacySection privacy={home.privacy} />
  <Faq faq={home.faq} />
  <Join join={home.join} form={home.form} appStoreUrl={site.appStoreUrl} />
</Layout>
