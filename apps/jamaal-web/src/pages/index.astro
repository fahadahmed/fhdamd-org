---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Kinds from "../components/sections/Kinds.astro";
import Anchors from "../components/sections/Anchors.astro";
import Priority from "../components/sections/Priority.astro";
import NightPlanningSection from "../components/sections/NightPlanningSection.astro";
import Wellbeing from "../components/sections/Wellbeing.astro";
import Nots from "../components/sections/Nots.astro";
import Pricing from "../components/sections/Pricing.astro";
import Closing from "../components/sections/Closing.astro";
import { LAUNCHED, SITE_DESCRIPTION } from "../data/site";
import { softwareApplicationJsonLd } from "../data/seo";

const jsonLd = softwareApplicationJsonLd({
  origin: Astro.site!.origin,
  description: SITE_DESCRIPTION,
  launched: LAUNCHED,
});
---

<Layout>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <Kinds />
  <Anchors />
  <Priority />
  <NightPlanningSection />
  <Wellbeing />
  <Nots />
  {LAUNCHED && <Pricing />}
  <Closing />
</Layout>
