---
import Layout from "../../layouts/Layout.astro";
import { CATEGORIES, listTitle, shortMeta } from "../../lib/journal";
import { loadJournal } from "../../lib/cms/pages";

const { site, page } = await loadJournal();
const { copy, posts } = page;
const featured = posts.find((p) => p.featured);
const rest = posts.filter((p) => p !== featured);
---

<Layout site={site} title={`${copy.eyebrow} — Jamaal`} description={copy.lede}>
  <div class="journal" data-journal>
    <header class="head">
      <div class="th-label th-eyebrow eyebrow">{copy.eyebrow}</div>
      <h1 class="section-title">{copy.title} <em>{copy.accent}</em></h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <div class="filters" role="group" aria-label="Filter by category">
      <button type="button" data-filter="All" aria-pressed="true">{copy.filterAll}</button>
      {CATEGORIES.map((category) => <button type="button" data-filter={category} aria-pressed="false">{category}</button>)}
    </div>

    {
      featured && (
        <a class="featured" href={`/journal/${featured.slug}`} data-category={featured.category}>
          <div class="featured-text">
            <span class="meta-line">{featured.category === "Guides" ? "Guide" : featured.category} · {featured.readMinutes} min read</span>
            <span class="featured-title">{featured.title} <em>{featured.accent}</em></span>
            <span class="featured-excerpt">{featured.featuredExcerpt ?? featured.excerpt}</span>
            <span class="read">{copy.readStory}</span>
          </div>
          {featured.cover && (
            <div class="featured-art" aria-hidden="true">
              <div class="phone">
                <img src={`${featured.cover.src}?auto=format&w=640`} alt="" loading="lazy" decoding="async" />
              </div>
            </div>
          )}
        </a>
      )
    }

    <ul class="list">
      {
        rest.map((post) => (
          <li data-category={post.category}>
            <a href={`/journal/${post.slug}`}>
              <span class="meta-line">{shortMeta(post)}</span>
              <span class="item-body">
                <span class="item-title">{listTitle(post)}</span>
                <span class="item-excerpt">{post.excerpt}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="empty" data-empty hidden>{copy.empty}</p>
  </div>
</Layout>

<script>
  import { setupJournalFilter } from "../../lib/journalFilter";

  setupJournalFilter();
</script>

<style>
  .journal {
    inline-size: min(1100px, 100% - 2 * clamp(20px, 4vw, 48px));
    margin-inline: auto;
    padding-block: clamp(40px, 6vw, 80px) clamp(56px, 8vw, 112px);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-inline-size: 720px;
  }

  .head :global(.section-title) {
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .filters button {
    min-block-size: 44px;
    padding-inline: 18px;
    border-radius: 999px;
    border: 1px solid var(--th-line-2);
    background: transparent;
    color: var(--th-ink);
    font: 500 12px / 1 var(--th-font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .filters button[aria-pressed="true"] {
    background: var(--th-deep);
    border-color: var(--th-deep);
    color: var(--th-on-deep);
  }

  .filters button:focus-visible,
  .featured:focus-visible,
  .list a:focus-visible {
    outline: 2px solid var(--th-terra);
    outline-offset: 2px;
  }

  [hidden] {
    display: none !important;
  }

  .featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    overflow: hidden;
    border-radius: var(--th-radius-card);
    background: var(--th-deep);
    text-decoration: none;
    color: var(--th-on-deep);
  }

  .featured:focus-visible {
    outline-color: var(--th-terra-on-deep);
  }

  .featured-text {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 16px;
    min-block-size: 320px;
    padding: clamp(28px, 4vw, 48px);
  }

  .featured .meta-line,
  .featured-excerpt {
    color: color-mix(in srgb, var(--th-on-deep) 78%, var(--th-deep));
  }

  .meta-line {
    font-family: var(--th-font-mono);
    font-size: var(--th-label-size);
    font-weight: 500;
    letter-spacing: var(--th-label-tracking);
    text-transform: uppercase;
    color: var(--th-ink-3);
  }

  .featured-title {
    font-family: var(--th-font-serif);
    font-variation-settings: var(--th-serif-axes);
    font-weight: 500;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.04;
  }

  .featured-title em {
    color: var(--th-accent-on-deep);
  }

  .featured-excerpt {
    font-size: 17px;
    line-height: 1.6;
    max-inline-size: 44ch;
  }

  .read {
    font-size: 15px;
    font-weight: 600;
    /* The design's terracotta on this blue is 4.45:1; a touch lighter clears the 4.5:1 minimum. */
    color: color-mix(in srgb, var(--th-terra-on-deep) 90%, white);
  }

  .featured-art {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-block-size: 320px;
    padding-block-start: 40px;
    overflow: hidden;
    background: #071b27;
  }

  .phone {
    inline-size: 240px;
    block-size: 320px;
    box-sizing: border-box;
    padding: 7px 7px 0;
    border-radius: 36px 36px 0 0;
    background: #000;
    overflow: hidden;
  }

  .phone :global(picture) {
    display: block;
    block-size: 100%;
  }

  .phone :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 30px 30px 0 0;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list a {
    display: grid;
    gap: 12px 40px;
    padding-block: 28px;
    border-block-start: 1px solid var(--th-line);
    text-decoration: none;
    color: var(--th-ink);
  }

  .item-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (min-width: 720px) {
    .list a {
      grid-template-columns: 1fr 2fr;
      align-items: baseline;
    }
  }

  .item-title {
    font-family: var(--th-font-serif);
    font-variation-settings: var(--th-serif-axes);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
  }

  .item-excerpt {
    font-size: 17px;
    line-height: 1.5;
    color: var(--th-ink-2);
    max-inline-size: 60ch;
  }

  .empty {
    margin: 0;
    color: var(--th-ink-2);
  }
</style>
