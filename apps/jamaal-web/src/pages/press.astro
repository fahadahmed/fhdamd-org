---
import Layout from "../layouts/Layout.astro";
import { loadPress } from "../lib/cms/pages";
import { cssVars } from "../lib/cssVars";

const { site, page: press } = await loadPress();

/** DatoCMS serves assets through imgix: `dl` makes the browser download the file under its own name, and `w` sizes the preview. */
const download = (file: (typeof press.files)[number]) => `${file.url}?dl=${encodeURIComponent(file.filename)}`;
const preview = (file: (typeof press.files)[number]) => (file.url.endsWith(".svg") ? file.url : `${file.url}?auto=format&w=480`);
---

<Layout site={site} title={`${press.eyebrow} — Jamaal`} description={`${press.intro}`}>
  <section class="press">
    <div class="press-inner">
      <div class="th-label th-eyebrow eyebrow">{press.eyebrow}</div>
      <h1 class="section-title press-title">{press.title}</h1>
      <p class="lede">{press.intro}</p>
      <p class="status">{press.status}</p>

      <h2 id="about">{press.aboutHeading}</h2>
      {press.about.map((paragraph) => <p class="copy">{paragraph}</p>)}

      <h2 id="facts">{press.factsHeading}</h2>
      <dl class="fact-list">
        {
          press.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <h2 id="downloads">{press.downloadsHeading}</h2>
      <ul class="files list-reset">
        {
          press.files.map((f) => (
            <li>
              <a class="thumb" href={download(f)}>
                {f.isImage && <img src={preview(f)} alt={f.alt} width={f.width ?? undefined} height={f.height ?? undefined} loading="lazy" decoding="async" />}
              </a>
              <div class="meta-row">
                <strong>{f.label}</strong>
                <span class="meta">{f.note}</span>
                <a href={download(f)}>Download</a>
              </div>
            </li>
          ))
        }
      </ul>

      <h2 id="brand">{press.brandHeading}</h2>
      <ul class="swatches list-reset">
        {
          press.colours.map((c) => (
            <li>
              <span class="swatch" style={cssVars({ swatch: c.hex })} aria-hidden="true"></span>
              <span><strong>{c.name}</strong> <code>{c.hex}</code><br /><span class="meta">{c.use}</span></span>
            </li>
          ))
        }
      </ul>
      <p class="copy">{press.fonts}</p>

      <h2 id="contact">{press.contactHeading}</h2>
      <p class="copy">
        {press.contactText} <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
      </p>
    </div>
  </section>
</Layout>
