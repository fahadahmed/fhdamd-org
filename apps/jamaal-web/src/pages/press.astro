---
import Layout from "../layouts/Layout.astro";
import { CONTACT_EMAIL } from "../data/site";
import { STAGE } from "../data/stage";
import { boilerplate, brand, facts, files, statusLine } from "../data/press";
---

<Layout
  title="Press kit — Jamaal"
  description="Facts, a short description, the app icon and screenshots for writing about Jamaal."
>
  <section class="press">
    <div class="press-inner">
      <div class="th-label th-eyebrow eyebrow">Press kit</div>
      <h1 class="section-title press-title">Writing about Jamaal?</h1>
      <p class="lede">{boilerplate.short} Everything below is free to use when you write about it.</p>
      <p class="status">{statusLine(STAGE)}</p>

      <h2 id="about">About Jamaal</h2>
      {boilerplate.long.map((paragraph) => <p class="copy">{paragraph}</p>)}

      <h2 id="facts">At a glance</h2>
      <dl class="fact-list">
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>

      <h2 id="downloads">Icon and screenshots</h2>
      <ul class="files">
        {
          files.map((f) => (
            <li>
              <a class="thumb" href={`/press/${f.file}`} download>
                <img src={`/press/${f.file}`} alt={f.alt} width={f.width} height={f.height} loading="lazy" decoding="async" />
              </a>
              <div class="meta-row">
                <strong>{f.label}</strong>
                <span class="meta">{f.note}</span>
                <a href={`/press/${f.file}`} download>Download</a>
              </div>
            </li>
          ))
        }
      </ul>

      <h2 id="brand">Colour and type</h2>
      <ul class="swatches">
        {
          brand.colours.map((c) => (
            <li>
              <span class="swatch" style={`background:${c.hex}`} aria-hidden="true"></span>
              <span><strong>{c.name}</strong> <code>{c.hex}</code><br /><span class="meta">{c.use}</span></span>
            </li>
          ))
        }
      </ul>
      <p class="copy">{brand.fonts}</p>

      <h2 id="contact">Contact</h2>
      <p class="copy">
        Questions, interviews or a different image size: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .press-inner {
    max-inline-size: 960px;
    margin-inline: auto;
    padding-block: var(--th-space-20) var(--th-space-24);
    padding-inline: var(--th-space-gutter);
    display: flex;
    flex-direction: column;
    gap: var(--th-space-section);
  }

  .press-title {
    font-size: var(--th-hero-size);
    font-weight: 300;
    line-height: var(--th-hero-leading);
  }

  .status {
    margin: 0;
    font-weight: 600;
    color: var(--th-ink);
  }

  h2 {
    margin: var(--th-space-8) 0 0;
    font-family: var(--th-font-serif);
    font-variation-settings: var(--th-serif-axes);
    font-weight: 500;
    font-size: var(--th-text-2xl);
    color: var(--th-ink);
  }

  .fact-list {
    margin: 0;
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--th-line);
  }

  .fact-list div {
    display: grid;
    grid-template-columns: minmax(110px, 0.3fr) 1fr;
    gap: 16px;
    padding-block: 14px;
    border-block-end: 1px solid var(--th-line);
  }

  .fact-list dt {
    font-family: var(--th-font-mono);
    font-size: var(--th-label-size);
    letter-spacing: var(--th-label-tracking);
    text-transform: uppercase;
    color: var(--th-ink-2);
  }

  .fact-list dd {
    margin: 0;
    color: var(--th-ink);
    line-height: 1.5;
  }

  .files {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 24px;
  }

  .thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: 240px;
    padding: 12px;
    border-radius: var(--th-radius-card);
    border: 1px solid var(--th-line);
    background: var(--th-sidebar);
    overflow: hidden;
  }

  .thumb img {
    max-inline-size: 100%;
    max-block-size: 100%;
    inline-size: auto;
    block-size: auto;
    object-fit: contain;
  }

  .meta-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block-start: 10px;
    font-size: 15px;
  }

  .meta-row a {
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 600;
  }

  .swatches {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }

  .swatches li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .swatch {
    flex: none;
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--th-radius-field);
    border: 1px solid var(--th-line-2);
  }

  code {
    font-family: var(--th-font-mono);
    font-size: 0.875rem;
  }
</style>
