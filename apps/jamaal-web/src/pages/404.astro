---
import Layout from "../layouts/Layout.astro";
import { loadSite } from "../lib/cms/pages";

const { site } = await loadSite();
---

<Layout site={site} title="Page not found — Jamaal" noindex>
  <section class="not-found">
    <p class="th-label">404</p>
    <h1 class="th-hero">Nothing here.</h1>
    <p class="th-lede">That page doesn't exist, or it has moved.</p>
    <p><a href="/">Back to Jamaal</a></p>
  </section>
</Layout>
