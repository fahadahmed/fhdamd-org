---
/** One chapter's devices, placed in the 600 x 640 space and scaled with the stage. */
import DeviceFrame from "./DeviceFrame.astro";
import { STAGE_SPACE, type DayDevice } from "../../data/layout";
import { cssVars } from "../../lib/cssVars";
import { screen } from "../../lib/screens";
import "../../styles/components/day-stage.css";

interface Props {
  devices: readonly DayDevice[];
  comingLabel: string;
}

const { devices, comingLabel } = Astro.props;
const { width, height } = STAGE_SPACE;
const pct = (value: number, of: number) => `${(value / of) * 100}%`;
---

<div class="comp">
  {
    devices.map((d) => (
      <div class="comp-item" style={cssVars({ x: pct(d.x, width), y: pct(d.y, height), w: pct(d.w, width), z: d.z ?? 1 })}>
        <DeviceFrame
          type={d.type}
          src={screen(d.src)}
          alt={d.alt}
          position={d.position}
          aspect={d.aspect}
          coming={d.coming}
          comingLabel={comingLabel}
          sizes={`(min-width: 960px) ${d.w}px, ${Math.round((d.w / width) * 100)}vw`}
        />
      </div>
    ))
  }
</div>
