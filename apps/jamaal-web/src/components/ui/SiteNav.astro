---
/**
 * The sticky glass pill: logo, section links and one filled call to action.
 * Static markup, no JavaScript. Below 960px the links hide and the pill is the
 * logo and the button, as in the design.
 */
import Logo from "./Logo.astro";
import { FEATURES } from "../../data/site";
import { STAGE } from "../../data/stage";
import { NAV_CTA, navLinks } from "../../lib/nav";

const links = navLinks(FEATURES);
const cta = NAV_CTA[STAGE];
---

<header class="site-nav">
  <nav class="pill" aria-label="Main">
    <a class="brand" href="/" aria-label="Jamaal, home">
      <Logo />
      <span class="brand-name">Jamaal</span>
    </a>
    <ul class="links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <a class="cta" href={cta.href}>{cta.label}</a>
  </nav>
</header>

<style>
  .site-nav {
    position: sticky;
    inset-block-start: 0;
    z-index: 200;
    padding: 12px clamp(16px, 3vw, 32px);
  }

  .pill {
    max-inline-size: 1240px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 8px 8px 18px;
    border-radius: 999px;
    background: var(--th-glass);
    backdrop-filter: var(--th-glass-blur);
    -webkit-backdrop-filter: var(--th-glass-blur);
    border: 1px solid var(--th-line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    text-decoration: none;
    color: var(--th-ink);
  }

  .brand-name {
    font-family: var(--th-font-serif);
    font-variation-settings: var(--th-serif-axes);
    font-weight: 500;
    font-size: 22px;
  }

  .links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 4px;
  }

  .links a {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 12px;
    border-radius: 999px;
    font-family: var(--th-font-mono);
    font-size: var(--th-label-size);
    font-weight: 500;
    letter-spacing: var(--th-label-tracking);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--th-ink);
  }

  .links a:hover {
    background: var(--th-sidebar);
  }

  /* The one filled colour on the page is terracotta. */
  .cta {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 20px;
    border-radius: 999px;
    background: var(--th-terra);
    color: var(--th-on-accent);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--th-duration-state) var(--th-ease-out);
  }

  .cta:hover {
    background: var(--th-terra-press);
    color: var(--th-on-accent);
  }

  .brand:focus-visible,
  .links a:focus-visible,
  .cta:focus-visible {
    outline: 2px solid var(--th-terra);
    outline-offset: 2px;
  }

  @media (min-width: 960px) {
    .links {
      display: flex;
    }
  }
</style>
