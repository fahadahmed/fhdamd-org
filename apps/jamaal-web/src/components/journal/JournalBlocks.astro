---
/** Renders an article's body. The HTML in a paragraph is the small subset (strong, em, links) that the data layer allows. */
import PhoneFigure from "./PhoneFigure.astro";
import type { Block } from "../../lib/journal";

interface Props {
  blocks: readonly Block[];
}

const { blocks } = Astro.props;
---

<div class="journal-body">
  {
    blocks.map((block) => {
      switch (block.type) {
        case "p":
          return <p set:html={block.html} />;
        case "h2":
          return <h2>{block.text}</h2>;
        case "figure":
          return (
            <div class="figures">
              {block.items.map((item) => <PhoneFigure item={item} />)}
            </div>
          );
        case "kv":
          return (
            <dl class="kv">
              {block.rows.map((row) => (
                <div>
                  <dt>{row.k}</dt>
                  <dd>{row.v}</dd>
                </div>
              ))}
            </dl>
          );
        case "quote":
          return (
            <blockquote>
              <p>{block.text}</p>
              {block.cite && <cite>{block.cite}</cite>}
            </blockquote>
          );
        case "list": {
          const List = block.ordered ? "ol" : "ul";
          return (
            <List>
              {block.items.map((html) => <li set:html={html} />)}
            </List>
          );
        }
        case "steps":
          return (
            <ol class="steps">
              {block.items.map((step, i) => (
                <li>
                  <div class="step-text">
                    <span class="step-n">Step {i + 1} of {block.items.length}</span>
                    <span class="step-title">{step.title}</span>
                    <span class="step-body">{step.body}</span>
                  </div>
                  {step.src && <PhoneFigure item={{ src: step.src, alt: step.alt ?? `${step.title}: screen ${i + 1}` }} width={220} />}
                </li>
              ))}
            </ol>
          );
      }
    })
  }
</div>
