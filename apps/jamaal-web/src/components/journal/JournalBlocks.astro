---
/** Renders an article's body. The HTML in a paragraph is the small subset (strong, em, links) that the data layer allows. */
import PhoneFigure from "./PhoneFigure.astro";
import type { Block } from "../../lib/journal";

interface Props {
  blocks: readonly Block[];
}

const { blocks } = Astro.props;
---

<div class="body">
  {
    blocks.map((block) => {
      switch (block.type) {
        case "p":
          return <p set:html={block.html} />;
        case "h2":
          return <h2>{block.text}</h2>;
        case "figure":
          return (
            <div class="figures">
              {block.items.map((item) => <PhoneFigure item={item} />)}
            </div>
          );
        case "kv":
          return (
            <dl class="kv">
              {block.rows.map((row) => (
                <div>
                  <dt>{row.k}</dt>
                  <dd>{row.v}</dd>
                </div>
              ))}
            </dl>
          );
        case "quote":
          return (
            <blockquote>
              <p>{block.text}</p>
              {block.cite && <cite>{block.cite}</cite>}
            </blockquote>
          );
        case "list": {
          const List = block.ordered ? "ol" : "ul";
          return (
            <List>
              {block.items.map((html) => <li set:html={html} />)}
            </List>
          );
        }
        case "steps":
          return (
            <ol class="steps">
              {block.items.map((step, i) => (
                <li>
                  <div class="step-text">
                    <span class="step-n">Step {i + 1} of {block.items.length}</span>
                    <span class="step-title">{step.title}</span>
                    <span class="step-body">{step.body}</span>
                  </div>
                  {step.src && <PhoneFigure item={{ src: step.src, alt: step.alt ?? `${step.title}: screen ${i + 1}` }} width={220} />}
                </li>
              ))}
            </ol>
          );
      }
    })
  }
</div>

<style>
  .body {
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--th-ink);
  }

  .body :global(p),
  .body :global(li) {
    margin: 0;
  }

  h2 {
    margin: 18px 0 0;
    font-family: var(--th-font-serif);
    font-variation-settings: var(--th-serif-axes);
    font-weight: 500;
    font-size: 2rem;
    line-height: 1.1;
    color: var(--th-ink);
  }

  .body :global(em) {
    font-style: italic;
  }

  .body :global(a) {
    color: var(--th-accent);
    text-decoration: underline;
  }

  .figures {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    padding-block: 8px;
  }

  .kv {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--th-line);
  }

  .kv > div {
    display: grid;
    grid-template-columns: minmax(120px, 0.4fr) 1fr;
    gap: 16px;
    padding-block: 14px;
    border-block-end: 1px solid var(--th-line);
  }

  .kv dt {
    font-size: 17px;
    font-weight: 700;
  }

  .kv dd {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--th-ink-2);
  }

  blockquote {
    margin: 0;
    padding: 20px 24px;
    border-radius: var(--th-radius-card);
    background: var(--th-sidebar);
    border-inline-start: 3px solid var(--th-terra);
  }

  blockquote p {
    font-family: var(--th-font-serif);
    font-variation-settings: var(--th-serif-axes);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  blockquote cite {
    display: block;
    margin-block-start: 8px;
    font-family: var(--th-font-mono);
    font-size: var(--th-label-size);
    font-style: normal;
    letter-spacing: var(--th-label-tracking);
    text-transform: uppercase;
    color: var(--th-ink-2);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .steps li {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 20px 32px;
    align-items: center;
    padding-block: 24px;
    border-block-start: 1px solid var(--th-line);
  }

  .step-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .step-n {
    font-family: var(--th-font-mono);
    font-size: var(--th-label-size);
    letter-spacing: var(--th-label-tracking);
    text-transform: uppercase;
    color: var(--th-ink-2);
  }

  .step-title {
    font-family: var(--th-font-serif);
    font-variation-settings: var(--th-serif-axes);
    font-weight: 500;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .step-body {
    font-size: 17px;
    line-height: 1.65;
    color: var(--th-ink-2);
  }
</style>
