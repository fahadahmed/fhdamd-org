---
import SectionHeading from "../ui/SectionHeading.astro";
import type { HomeModel } from "../../lib/cms/models";

interface Props {
  pricing: HomeModel["pricing"];
}

const { pricing } = Astro.props;
---

<section id="pricing" class="section section--sidebar">
  <div class="section-inner split split--top">
    <div class="stack stack--tight">
      <SectionHeading eyebrow={pricing.eyebrow} title={pricing.title} accent={pricing.accent} />
      <p class="copy">{pricing.lede}</p>
    </div>
    <div class="stack stack--tight">
      {
        pricing.plans.map((plan) => (
          <div class:list={["plan", { "plan--featured": plan.featured }]}>
            <div class="plan-name">{plan.name}</div>
            <div class="plan-price">{plan.price}</div>
            <div class="meta">{plan.unit}</div>
          </div>
        ))
      }
      <p class="copy plan-note">{pricing.afterTrial}</p>
      <p class="meta">{pricing.currency}</p>
    </div>
  </div>
</section>
