---
import AppStoreButton from "../AppStoreButton/AppStoreButton";
import SignupForm from "../SignupForm/SignupForm";
import { STAGE } from "../../data/stage";
import type { HomeModel } from "../../lib/cms/models";

interface Props {
  join: HomeModel["join"];
  form: HomeModel["form"];
  appStoreUrl: string;
}

const { join: copy, form, appStoreUrl } = Astro.props;
/** The signup form is for the two pre-launch stages; launched shows the App Store button. */
const formStage = STAGE === "launched" ? null : STAGE;
---

<section id="join" class="section section--deep">
  <div class="section-inner closing">
    <h2 class="section-title section-title--hero">{copy.title} <em>{copy.accent}</em></h2>
    <p class="lede">{copy.lede}</p>
    {
      formStage ? (
        <SignupForm client:visible variant="join" stage={formStage} source="join" copy={form} />
      ) : (
        <AppStoreButton href={appStoreUrl} />
      )
    }
  </div>
</section>
