---
import SectionHeading from "../ui/SectionHeading.astro";
import { principles } from "../../data/home";
---

<section id="principles" class="section section--card">
  <div class="section-inner stack">
    <div class="stack stack--tight" style="max-inline-size: 780px">
      <SectionHeading eyebrow={principles.eyebrow} title={principles.title} accent={principles.accent} />
      <p class="copy">{principles.body}</p>
    </div>
    <ul class="principles">
      {
        principles.items.map((item) => (
          <li class="principle">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
