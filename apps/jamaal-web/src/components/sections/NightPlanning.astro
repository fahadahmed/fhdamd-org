---
/**
 * Night Planning: five steps, each with its own screen. Choosing a step swaps
 * the phone's screen (a small script); without JavaScript the first screen
 * stays and the steps still read in order. Then the iPad and Mac canvas.
 */
import { Picture } from "astro:assets";
import DeviceFrame from "../ui/DeviceFrame.astro";
import type { HomeModel } from "../../lib/cms/models";

interface Props {
  plan: HomeModel["plan"];
}

const { plan } = Astro.props;
import { screen } from "../../lib/screens";
---

<section id="plan" class="plan">
  <div class="plan-inner">
    <div class="plan-head">
      <div class="th-label th-eyebrow plan-eyebrow">{plan.eyebrow}</div>
      <h2 class="plan-title">{plan.title} <em>{plan.accent}</em></h2>
      <p class="plan-lede">{plan.body}</p>
    </div>

    <div class="plan-steps" data-stepper>
      <div class="plan-phone">
        <DeviceFrame type="phone" bezel="#000">
          {
            plan.steps.map((step, i) => (
              <Picture
                src={screen(step.src)}
                alt={`Night Planning, step ${i + 1}: ${step.title}`}
                widths={[320, 480, 640]}
                sizes="(min-width: 960px) 300px, 78vw"
                formats={["avif", "webp"]}
                loading={i === 0 ? "lazy" : "lazy"}
                class="screen"
                data-step-img
                data-active={i === 0 ? "" : undefined}
                aria-hidden={i === 0 ? "false" : "true"}
              />
            ))
          }
        </DeviceFrame>
      </div>
      <ol class="steps">
        {
          plan.steps.map((step, i) => (
            <li>
              <button type="button" data-step aria-current={i === 0 ? "step" : undefined}>
                <span class="num" aria-hidden="true">{i + 1}</span>
                <span class="step-text">
                  <span class="step-title">{step.title}</span>
                  <span class="step-body">{step.body}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="canvas">
      <div class="canvas-frame">
        <DeviceFrame type="ipad" src={screen(plan.canvas.src)} alt={plan.canvas.alt} aspect="1180 / 820" bezel="#000" sizes="(min-width: 960px) 560px, 90vw" />
      </div>
      <div class="canvas-text">
        <div class="th-label th-eyebrow plan-eyebrow">{plan.canvas.label}</div>
        <p>{plan.canvas.body}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupStepper } from "../../lib/stepper";

  setupStepper();
</script>

<style>
  .plan {
    background: var(--site-deeper);
    color: var(--th-on-deep);
    padding: clamp(56px, 8vw, 112px) clamp(20px, 4vw, 48px);
  }

  .plan-inner {
    max-inline-size: 1240px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .plan-head {
    max-inline-size: 760px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .plan-eyebrow {
    color: var(--th-on-deep-2);
  }

  .plan-title {
    margin: 0;
    font-family: var(--th-font-serif);
    font-variation-settings: var(--th-serif-axes);
    font-weight: 500;
    font-size: clamp(2.125rem, 4.6vw, 3.5rem);
    line-height: 1.04;
    color: var(--th-on-deep);
    text-wrap: balance;
  }

  .plan-title em {
    font-style: italic;
    color: var(--th-accent-on-deep);
  }

  .plan-lede {
    margin: 0;
    max-inline-size: 54ch;
    font-size: 19px;
    line-height: 1.6;
    color: var(--th-on-deep-2);
    text-wrap: pretty;
  }

  .plan-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 48px;
    align-items: center;
  }

  .plan-phone {
    justify-self: center;
    inline-size: min(300px, 78vw);
    filter: drop-shadow(0 40px 40px rgb(0 0 0 / 0.5));
  }

  .plan-phone :global(.screen) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transition: opacity 400ms var(--th-ease-out);
  }

  .plan-phone :global(.screen[data-active]) {
    opacity: 1;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .steps li {
    border-block-start: 1px solid color-mix(in srgb, var(--th-on-deep) 14%, transparent);
  }

  .steps button {
    inline-size: 100%;
    display: flex;
    gap: 18px;
    padding: 18px 12px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: background-color 200ms;
  }

  .steps button:hover {
    background: color-mix(in srgb, var(--th-on-deep) 5%, transparent);
  }

  /* The chosen step is marked by its ground and an accent number, not by dimming the others. */
  .steps button[aria-current="step"] {
    background: color-mix(in srgb, var(--th-on-deep) 9%, transparent);
  }

  .steps button:focus-visible {
    outline: 2px solid var(--th-terra-on-deep);
    outline-offset: -2px;
  }

  .num {
    inline-size: 24px;
    flex-shrink: 0;
    font-family: var(--th-font-serif);
    font-weight: 300;
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--th-on-deep-2);
  }

  button[aria-current="step"] .num {
    color: var(--th-accent-on-deep);
  }

  .step-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .step-title {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--th-on-deep);
  }

  .step-body {
    max-inline-size: 46ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--th-on-deep-2);
  }

  .canvas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 32px 48px;
    align-items: center;
    padding-block-start: 48px;
    border-block-start: 1px solid color-mix(in srgb, var(--th-on-deep) 14%, transparent);
  }

  .canvas-frame {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--th-on-deep) 16%, transparent);
    border-radius: 28px;
  }

  .canvas-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .canvas-text p {
    margin: 0;
    max-inline-size: 40ch;
    font-size: 19px;
    line-height: 1.6;
    color: var(--th-on-deep);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-phone :global(.screen),
    .steps button {
      transition: none;
    }
  }
</style>
