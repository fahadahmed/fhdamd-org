---
/**
 * Night Planning: five steps, each with its own screen. Choosing a step swaps
 * the phone's screen (a small script); without JavaScript the first screen
 * stays and the steps still read in order. Then the iPad and Mac canvas.
 */
import { Picture } from "astro:assets";
import DeviceFrame from "../ui/DeviceFrame.astro";
import type { HomeModel } from "../../lib/cms/models";

interface Props {
  plan: HomeModel["plan"];
}

const { plan } = Astro.props;
import { screen } from "../../lib/screens";
import "../../styles/components/night-planning.css";
---

<section id="plan" class="night-plan">
  <div class="plan-inner">
    <div class="plan-head">
      <div class="th-label th-eyebrow plan-eyebrow">{plan.eyebrow}</div>
      <h2 class="plan-title">{plan.title} <em>{plan.accent}</em></h2>
      <p class="plan-lede">{plan.body}</p>
    </div>

    <div class="plan-steps" data-stepper>
      <div class="plan-phone">
        <DeviceFrame type="phone" bezel="#000">
          {
            plan.steps.map((step, i) => (
              <Picture
                src={screen(step.src)}
                alt={`Night Planning, step ${i + 1}: ${step.title}`}
                widths={[320, 480, 640]}
                sizes="(min-width: 960px) 300px, 78vw"
                formats={["avif", "webp"]}
                loading={i === 0 ? "lazy" : "lazy"}
                class="screen"
                data-step-img
                data-active={i === 0 ? "" : undefined}
                aria-hidden={i === 0 ? "false" : "true"}
              />
            ))
          }
        </DeviceFrame>
      </div>
      <ol class="steps list-reset">
        {
          plan.steps.map((step, i) => (
            <li>
              <button type="button" data-step aria-current={i === 0 ? "step" : undefined}>
                <span class="num" aria-hidden="true">{i + 1}</span>
                <span class="step-text">
                  <span class="step-title">{step.title}</span>
                  <span class="step-body">{step.body}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="canvas">
      <div class="canvas-frame">
        <DeviceFrame type="ipad" src={screen(plan.canvas.src)} alt={plan.canvas.alt} aspect="1180 / 820" bezel="#000" sizes="(min-width: 960px) 560px, 90vw" />
      </div>
      <div class="canvas-text">
        <div class="th-label th-eyebrow plan-eyebrow">{plan.canvas.label}</div>
        <p>{plan.canvas.body}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupStepper } from "../../lib/stepper";

  setupStepper();
</script>
