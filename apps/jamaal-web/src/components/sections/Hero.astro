---
import AppStoreButton from "../AppStoreButton/AppStoreButton";
import WaitlistForm from "../WaitlistForm/WaitlistForm";
import DeviceFrame from "../ui/DeviceFrame.astro";
import { formCopy, hero, heroEyebrow } from "../../data/home";
import { APP_STORE_URL } from "../../data/site";
import { STAGE } from "../../data/stage";
import { screen } from "../../lib/screens";

const form = STAGE === "launched" ? null : formCopy(STAGE);
---

<section class="hero" id="top">
  <div class="hero-copy">
    <div class="th-label th-eyebrow eyebrow">{heroEyebrow(STAGE)}</div>
    <h1 class="hero-title">{hero.title}<br />{hero.titleLine2}<br /><em>{hero.accent}</em></h1>
    <p class="lede">{hero.lede}</p>

    {
      form ? (
        <div class="hero-actions" id="join-top">
          <WaitlistForm client:idle variant="hero" source="hero" submitLabel={form.submitLabel} note={form.note} />
        </div>
      ) : (
        <div class="hero-actions">
          <AppStoreButton href={APP_STORE_URL} />
          <div class="meta">{hero.trialNote}</div>
        </div>
      )
    }
  </div>

  <div class="hero-visual">
    <div class="hero-stage">
      <div class="hero-mac">
        <DeviceFrame type="mac" src={screen("g-macOS")} alt="Jamaal's Today view on a Mac" sizes="(min-width: 960px) 540px, 90vw" loading="eager" />
      </div>
      <div class="hero-phone">
        <DeviceFrame type="phone" src={screen("g-TD-01")} alt="Today on iPhone" sizes="(min-width: 960px) 200px, 34vw" loading="eager" />
      </div>
      <div class="hero-widget">
        <DeviceFrame type="widget" src={screen("WG-03-today-medium")} alt="The Today widget on the Home Screen" sizes="(min-width: 960px) 320px, 54vw" />
      </div>
    </div>
  </div>
</section>
