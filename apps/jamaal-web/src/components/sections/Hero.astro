---
import AppStoreButton from "../AppStoreButton/AppStoreButton";
import WaitlistForm from "../WaitlistForm/WaitlistForm";
import PhoneFrame from "../ui/PhoneFrame.astro";
import { hero } from "../../data/content";
import { APP_STORE_URL, LAUNCHED } from "../../data/site";
import today from "../../assets/screens/today.png";
import duo from "../../assets/screens/duo.png";
---

<section class="hero" id="top">
  <div class="hero-copy">
    <div class="th-label th-eyebrow eyebrow">
      {LAUNCHED ? hero.launched.eyebrow : hero.prelaunch.eyebrow}
    </div>
    <h1 class="hero-title">{hero.title} <em>{hero.accent}</em></h1>
    <p class="lede">{hero.lede}</p>

    {
      LAUNCHED ? (
        <div class="hero-actions">
          <div class="hero-links">
            <AppStoreButton href={APP_STORE_URL} />
            <a class="text-link" href="#pricing">See pricing</a>
          </div>
          <div class="meta">{hero.trialNote}</div>
        </div>
      ) : (
        <div class="hero-actions">
          <WaitlistForm
            client:idle
            variant="hero"
            source="hero"
            submitLabel="Tell me when it's ready"
            note={hero.signupNote}
          />
        </div>
      )
    }
  </div>

  <div class="hero-visual">
    <div class="hero-phones">
      <PhoneFrame image={today} alt="Jamaal's Today screen" eager />
      <PhoneFrame
        image={duo}
        alt="Jamaal's Today list on iPhone Duo, folded, with navigation down the right edge"
        width={384}
        ratio={[952, 1346]}
        eager
      />
    </div>
  </div>
</section>
