---
import SectionHeading from "../ui/SectionHeading.astro";
import type { HomeModel } from "../../lib/cms/models";

interface Props {
  why: HomeModel["why"];
}

const { why } = Astro.props;
---

<section id="why" class="section section--card">
  <div class="section-inner stack">
    <div class="stack stack--tight section-head">
      <SectionHeading eyebrow={why.eyebrow} title={why.title} accent={why.accent} />
      <p class="copy copy--wide">{why.body}</p>
    </div>
    <div class="compare">
      <div class="compare-head th-label" aria-hidden="true">
        <span>{why.columns.them}</span>
        <span>{why.columns.us}</span>
      </div>
      <ul class="compare-rows list-reset">
        {
          why.rows.map((row) => (
            <li class="compare-row">
              <p><span class="sr-only">{why.columns.them}: </span>{row.them}</p>
              <p class="compare-us"><span class="sr-only">{why.columns.us}: </span>{row.us}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
