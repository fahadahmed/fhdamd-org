---
import SectionHeading from "../ui/SectionHeading.astro";
import type { HomeModel } from "../../lib/cms/models";

interface Props {
  privacy: HomeModel["privacy"];
}

const { privacy } = Astro.props;
---

<section class="section" aria-labelledby="privacy-title">
  <div class="section-inner stack">
    <SectionHeading eyebrow={privacy.eyebrow} title={privacy.title} accent={privacy.accent} id="privacy-title" />
    <ul class="facts list-reset">
      {
        privacy.items.map((item) => (
          <li class="fact">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
