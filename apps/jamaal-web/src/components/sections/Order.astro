---
import HiddenOrder from "../HiddenOrder/HiddenOrder";
import SectionHeading from "../ui/SectionHeading.astro";
import { order } from "../../data/home";
---

<section id="order" class="section">
  <div class="section-inner split">
    <HiddenOrder client:idle>
      <SectionHeading eyebrow={order.eyebrow} title={order.title} accent={order.accent} />
      {order.paragraphs.map((text) => <p class="copy">{text}</p>)}
    </HiddenOrder>
  </div>
</section>
