---
import "@fhdamd/threads/tokens";
import "@fhdamd/threads/styles";
import "@fhdamd/threads/base";
import "../styles/global.css";
import "../styles/landing.css";
import "../styles/utilities.css";
import SiteNav from "../components/ui/SiteNav.astro";
import SiteFooter from "../components/ui/SiteFooter.astro";
import ConsentBanner from "../components/ui/ConsentBanner.astro";
import type { SeoModel, SiteModel } from "../lib/cms/models";

interface Props {
  /** The site settings from DatoCMS: the nav, the footer, the name and the default description. */
  site: SiteModel;
  /** What this page puts in its <head>: see lib/cms/seo.ts. */
  seo: SeoModel;
  /** `article` for a Journal post. */
  type?: "website" | "article";
  /** For an article: when it was published and its category. */
  article?: { publishedTime: string; section: string };
  /** Structured data for the page (schema.org), one script each. */
  jsonLd?: readonly object[];
  /** Advertise the Journal's RSS feed to readers and browsers. */
  feed?: boolean;
}

const { site, seo, type = "website", article, jsonLd = [], feed = false } = Astro.props;

// Firebase Hosting serves pages without a trailing slash (and redirects the slash form), so that is the canonical address.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(path, Astro.site).href;
const imageUrl = new URL(seo.image.url, Astro.site).href;

// The two faces every page needs straight away (the display serif and the interface sans). The
// others load when the page first uses them. The files are in src/assets/fonts; see global.css.
import frauncesUrl from "../assets/fonts/fraunces-latin-full-normal.woff2?url";
import hankenUrl from "../assets/fonts/hanken-grotesk-latin-wght-normal.woff2?url";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#EFF4F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12303F" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {!seo.noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="robots" content={seo.noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    {feed && <link rel="alternate" type="application/rss+xml" title={`${site.name} Journal`} href="/journal/rss.xml" />}

    <!-- Open Graph -->
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageUrl} />
    {seo.image.width && <meta property="og:image:width" content={String(seo.image.width)} />}
    {seo.image.height && <meta property="og:image:height" content={String(seo.image.height)} />}
    <meta property="og:image:alt" content={seo.image.alt} />
    <meta property="og:locale" content="en" />
    <meta property="og:site_name" content={site.name} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:section" content={article.section} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={seo.image.alt} />

    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}

    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hankenUrl} as="font" type="font/woff2" crossorigin />

    <slot name="head" />

    <!-- Apply the saved or system theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("th-theme");
          const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", saved || preferred);
        } catch {
          /* storage blocked: keep the light default */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav site={site} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter site={site} />
    <ConsentBanner />
    <script>
      import { SENTRY_DSN, installErrorReporting } from "../lib/errorReporting";

      installErrorReporting({ win: window, dsn: SENTRY_DSN });
    </script>
  </body>
</html>
