---
import { Accordion, Prose } from "@fhdamd/threads";
import Layout from "./Layout.astro";
import type { ContentPageModel, SeoModel, SiteModel } from "../lib/cms/models";
import "../styles/components/legal-page.css";

interface Props {
  site: SiteModel;
  /** A page from DatoCMS: privacy, terms or support. */
  page: ContentPageModel;
  seo: SeoModel;
}

const { site, page, seo } = Astro.props;
---

<Layout site={site} seo={seo}>
  <section class="legal">
    <div class="legal-inner">
      <div class="th-label th-eyebrow eyebrow">{page.eyebrow}</div>
      <h1 class="section-title legal-title">{page.title}</h1>
      {page.updated && <p class="meta">Last updated {page.updated}</p>}
      <Prose>
        {
          page.blocks.map((block) => {
            if (block.type === "h2") return <h2 id={block.id}>{block.text}</h2>;
            if (block.type === "p") return <p set:html={block.html} />;
            if (block.type === "note") return <p>{block.text}</p>;
            if (block.type === "faq") return <Accordion client:visible items={block.items} defaultOpenIndex={-1} />;
            const List = block.ordered ? "ol" : "ul";
            return (
              <List>
                {block.items.map((item) => (
                  <li set:html={item} />
                ))}
              </List>
            );
          })
        }
      </Prose>
    </div>
  </section>
</Layout>
