---
import { createElement, Fragment as ReactFragment } from "react";
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import {
  Container,
  Section,
  Stack,
  Cluster,
  Grid,
  Badge,
  Tag,
  Button,
  DarkStrip,
  Breadcrumb,
  Prose,
  TableOfContents,
  ContentCard,
  SectionHeader,
} from "@fhdamd/threads";
import { getSiteSettings } from "../../lib/content";
import { mdxComponents } from "../../components/mdx";
import { titleToReact, markupToHtml } from "../../utils/titleToReact";
import { BLOG_TAG_LABELS, BLOG_TAG_BADGE_VARIANT } from "../../utils/blogTags";
import { computeReadTime } from "../../utils/computeReadTime";
import { ArrowRightIcon, TwitterIcon, LinkedInIcon, ArticleReadingProgress, CopyLinkButton } from "../../components";
import "../../styles/blogPost.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
// getStaticPaths only generates a route per collection entry above, so this is always found.
const post = (await getEntry("blog", slug))!;
const { Content, headings } = await render(post);

const allPosts = await getCollection("blog");
const settings = await getSiteSettings();

const heroTitleHtml = markupToHtml(post.data.title);
const arrowRightIcon = createElement(ArrowRightIcon);

const breadcrumbItems = [
  { label: "Blog", href: "/blog" },
  { label: post.data.breadcrumbCategory },
];

const tocItems = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));

const relatedPosts = post.data.relatedSlugs
  .map((relSlug) => allPosts.find((p) => p.id === relSlug))
  .filter((p): p is (typeof allPosts)[number] => Boolean(p));
const relatedTitle = titleToReact("Related *posts*");

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareText = encodeURIComponent(post.data.title.replace(/\*/g, ""));
const twitterShareHref = `https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(canonicalUrl)}`;
const linkedinShareHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`;

const ctaHeading = titleToReact(settings.ctaTitle);
const ctaActions = createElement(
  ReactFragment,
  null,
  createElement(Button, {
    href: "/services",
    variant: "solid-ink",
    icon: arrowRightIcon,
    children: "View services",
  }),
  createElement(Button, {
    href: "/contact",
    variant: "ghost-inverse",
    children: "Get in touch",
  }),
);
---

<Layout
  title={`${post.data.title.replace(/\*/g, "")} — Fahad Ahmed · fhdamd.dev`}
  description={post.data.dek}
  ogType="article"
>
  <ArticleReadingProgress client:load targetSelector=".post-article" />

  <Container>
    <Stack gap={5} className="post-hero">
      <Breadcrumb items={breadcrumbItems} />
      <Cluster gap={2}>
        {
          post.data.tags.map((tag) => (
            <Badge variant="neutral">{BLOG_TAG_LABELS[tag] ?? tag}</Badge>
          ))
        }
      </Cluster>
      <h1 class="post-hero__title" set:html={heroTitleHtml} />
      <p class="post-hero__dek">{post.data.dek}</p>
      <Cluster gap={3} className="post-byline">
        <Cluster gap={2}>
          <div class="post-byline__avatar">{settings.authorInitials}</div>
          <div>
            <div class="post-byline__name">{settings.authorName}</div>
            <div class="post-byline__role">{settings.authorRole}</div>
          </div>
        </Cluster>
        <span class="post-byline__sep">·</span>
        <span class="post-byline__item">{post.data.date}</span>
        <span class="post-byline__sep">·</span>
        <span class="post-byline__item">{computeReadTime(post.body ?? "")}</span>
      </Cluster>
    </Stack>
  </Container>

  <Container>
    <div class="post-layout">
      <TableOfContents client:load items={tocItems} stickyOffset={59} />

      <Prose className="post-article">
        <Content components={mdxComponents} />

        <Cluster gap={4} justify="between" className="post-footer-meta">
          <Cluster gap={2}>
            {post.data.postTags.map((tag) => <Tag>{tag}</Tag>)}
          </Cluster>
          <Cluster gap={2}>
            <a
              class="share-btn"
              href={twitterShareHref}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on X"
              title="Share on X"
            >
              <TwitterIcon />
            </a>
            <a
              class="share-btn"
              href={linkedinShareHref}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on LinkedIn"
              title="Share on LinkedIn"
            >
              <LinkedInIcon />
            </a>
            <CopyLinkButton client:load />
          </Cluster>
        </Cluster>
      </Prose>
    </div>
  </Container>

  {
    relatedPosts.length > 0 && (
      <section style="border-top:1px solid var(--th-color-border-default)">
        <Container>
          <Section size="md">
            <Stack gap={8}>
              <SectionHeader title={relatedTitle} meta="More from the blog" />
              <Grid cols={3} gap={4}>
                {relatedPosts.map((rp) => (
                  <ContentCard
                    href={`/blog/${rp.id}`}
                    date={rp.data.date}
                    description={rp.data.dek}
                    title={titleToReact(rp.data.title, {
                      color: "var(--th-color-accent)",
                    })}
                    badges={[
                      {
                        label: BLOG_TAG_LABELS[rp.data.tags[0]] ?? rp.data.tags[0],
                        variant: BLOG_TAG_BADGE_VARIANT[rp.data.tags[0]],
                      },
                    ]}
                  />
                ))}
              </Grid>
            </Stack>
          </Section>
        </Container>
      </section>
    )
  }

  <Container>
    <Section size="md">
      <DarkStrip
        heading={ctaHeading}
        body={settings.ctaSubtitle}
        align="start"
        actions={ctaActions}
      />
    </Section>
  </Container>
</Layout>
