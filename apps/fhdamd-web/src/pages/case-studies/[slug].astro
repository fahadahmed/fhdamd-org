---
import { createElement, Fragment as ReactFragment } from "react";
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import {
  Container,
  Section,
  Stack,
  Cluster,
  Grid,
  Badge,
  Tag,
  Button,
  DarkStrip,
  Breadcrumb,
  Prose,
  TableOfContents,
  ContentCard,
  SectionHeader,
  FactStrip,
  AuthorBox,
} from "@fhdamd/threads";
import { getSiteSettings } from "../../lib/content";
import { mdxComponents } from "../../components/mdx";
import { titleToReact, markupToHtml } from "../../utils/titleToReact";
import { ArrowRightIcon, TwitterIcon, LinkedInIcon, ArticleReadingProgress, CopyLinkButton } from "../../components";
import "../../styles/blogPost.css";

export async function getStaticPaths() {
  const items = await getCollection("caseStudies", ({ data }) => data.status === "published");
  return items.map((item) => ({ params: { slug: item.id } }));
}

const { slug } = Astro.params;
// getStaticPaths only generates a route per published entry above, so this is always found.
const study = (await getEntry("caseStudies", slug))!;
const { Content, headings } = await render(study);

const settings = await getSiteSettings();

const heroTitleHtml = markupToHtml(study.data.title);
const arrowRightIcon = createElement(ArrowRightIcon);

const breadcrumbItems = [
  { label: "Case Studies", href: "/case-studies" },
  { label: study.data.breadcrumbCategory },
];

const tocItems = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));

const facts = [
  { label: "Client", value: study.data.client },
  { label: "Industry", value: study.data.industry },
  { label: "Timeline", value: study.data.timeline },
  { label: "Offering", value: study.data.offering },
  { label: "Stack", value: study.data.stack.join(" · ") },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));

const buildCreditBio = createElement(
  ReactFragment,
  null,
  `${study.data.buildCreditBio ?? ""} Considering something similar? `,
  createElement("a", { href: "/contact" }, "Get a proposal"),
  ".",
);

const relatedTitle = titleToReact("More *case studies*");

const canonicalUrl = new URL(Astro.url.pathname, "https://fhdamd.dev").href;
const shareText = encodeURIComponent(study.data.title.replace(/\*/g, ""));
const twitterShareHref = `https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(canonicalUrl)}`;
const linkedinShareHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`;

const ctaHeading = titleToReact(settings.ctaTitle);
const ctaActions = createElement(
  ReactFragment,
  null,
  createElement(Button, {
    href: "/services",
    variant: "solid-ink",
    icon: arrowRightIcon,
    children: "View services",
  }),
  createElement(Button, {
    href: "/contact",
    variant: "ghost",
    children: "Get in touch",
  }),
);
---

<Layout
  title={`${study.data.title.replace(/\*/g, "")} — Fahad Ahmed · fhdamd.dev`}
  description={study.data.dek}
>
  <ArticleReadingProgress client:load targetSelector=".post-article" />

  <Container>
    <Stack gap={5} className="post-hero">
      <Breadcrumb items={breadcrumbItems} />
      <Cluster gap={2}>
        {study.data.badges.map((b) => <Badge variant={b.variant}>{b.label}</Badge>)}
      </Cluster>
      <h1 class="post-hero__title" set:html={heroTitleHtml} />
      <p class="post-hero__dek">{study.data.dek}</p>
      <Cluster gap={3} className="post-byline">
        <Cluster gap={2}>
          <div class="post-byline__avatar">{settings.authorInitials}</div>
          <div>
            <div class="post-byline__name">{settings.authorName}</div>
            <div class="post-byline__role">{settings.authorRole}</div>
          </div>
        </Cluster>
        <span class="post-byline__sep">·</span>
        <span class="post-byline__item">{study.data.client}</span>
        <span class="post-byline__sep">·</span>
        <span class="post-byline__item">{study.data.location}</span>
      </Cluster>
    </Stack>
  </Container>

  <Container>
    <FactStrip facts={facts} />
  </Container>

  <Container>
    <div class="post-layout">
      <TableOfContents client:load items={tocItems} />

      <Prose className="post-article">
        <Content components={mdxComponents} />

        <Cluster gap={4} justify="between" className="post-footer-meta">
          <Cluster gap={2}>
            {study.data.tags.map((tag) => <Tag>{tag}</Tag>)}
          </Cluster>
          <Cluster gap={2}>
            <a
              class="share-btn"
              href={twitterShareHref}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on X"
              title="Share on X"
            >
              <TwitterIcon />
            </a>
            <a
              class="share-btn"
              href={linkedinShareHref}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Share on LinkedIn"
              title="Share on LinkedIn"
            >
              <LinkedInIcon />
            </a>
            <CopyLinkButton client:load />
          </Cluster>
        </Cluster>

        <AuthorBox
          initials={settings.authorInitials}
          name={study.data.buildCreditName ?? settings.authorName}
          role={study.data.buildCreditRole ?? settings.authorRole}
          bio={buildCreditBio}
        />
      </Prose>
    </div>
  </Container>

  {
    study.data.relatedItems.length > 0 && (
      <section style="border-top:1px solid var(--th-color-border-default)">
        <Container>
          <Section size="md">
            <Stack gap={8}>
              <SectionHeader title={relatedTitle} meta="See the full list" />
              <Grid cols={3} gap={4}>
                {study.data.relatedItems.map((item) => (
                  <ContentCard
                    href={item.href}
                    date={item.dateLabel}
                    title={item.title}
                    badges={[
                      { label: item.badgeLabel, variant: item.badgeVariant },
                    ]}
                  />
                ))}
              </Grid>
            </Stack>
          </Section>
        </Container>
      </section>
    )
  }

  <Container>
    <Section size="md">
      <DarkStrip
        heading={ctaHeading}
        body={settings.ctaSubtitle}
        align="start"
        actions={ctaActions}
      />
    </Section>
  </Container>
</Layout>
