---
import "@fhdamd/threads/tokens";
import "@fhdamd/threads/styles";
import "../styles/global.css";
import Header from "../components/Header/Header";
import Footer from "../components/Footer/Footer";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "Fahad Ahmed — Software engineer for hire, Melbourne",
  description = "I build custom websites and apps. 14 years shipping production software across government, finance, and utilities.",
  ogImage = new URL("/og-image.png", Astro.site).href,
  ogType = "website",
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Unset in local dev / PR preview builds by design — only the production
// deploy's CI env carries a real value, so those builds don't pollute
// production analytics data. See #335.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="fhdamd.dev" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Load branded fonts after the initial render path. -->
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=JetBrains+Mono:wght@400;500&display=optional"
        rel="stylesheet"
      />
    </noscript>
    <script is:inline>
      (() => {
        const fontHref = "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&family=JetBrains+Mono:wght@400;500&display=optional";
        let loaded = false;

        const loadFonts = () => {
          if (loaded) return;
          loaded = true;
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = fontHref;
          document.head.appendChild(link);
        };

        window.addEventListener("load", loadFonts, { once: true });
        ["pointerdown", "keydown", "touchstart"].forEach((eventName) => {
          window.addEventListener(eventName, loadFonts, { once: true, passive: true });
        });
      })();
    </script>

    <slot name="head" />

    {gaMeasurementId && (
      <>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", gaMeasurementId);

          const loadAnalytics = () => {
            if (document.querySelector('script[data-fhdamd-analytics]')) return;
            const script = document.createElement("script");
            script.dataset.fhdamdAnalytics = "true";
            script.async = true;
            script.src = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
            document.head.appendChild(script);
          };

          const scheduleAnalytics = () => {
            const timer = window.setTimeout(loadAnalytics, 10000);
            const loadAfterInteraction = () => {
              window.clearTimeout(timer);
              loadAnalytics();
            };
            ["pointerdown", "keydown", "touchstart"].forEach((eventName) => {
              window.addEventListener(eventName, loadAfterInteraction, { once: true, passive: true });
            });
          };

          window.addEventListener("load", scheduleAnalytics, { once: true });
        </script>
      </>
    )}

    <!-- Initialise theme from localStorage before first paint to avoid flash -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("th-theme");
        const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", saved || preferred);
      })();
    </script>
  </head>
  <body>
    <Header client:idle currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer copyright={`fhdamd.dev · Melbourne, VIC · ${new Date().getFullYear()}`} />
  </body>
</html>
